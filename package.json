{
  "name": "Figma-Powerpoint-Export",
  "version": "1.0.0",
  "description": "Rasterize a Figma Slides deck into a pixel-exact PowerPoint with compressed images, speaker notes and embedded videos.",
  "main": "dist/code.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src build.js",
    "lint:fix": "eslint src build.js --fix",
    "release": "npm run build && mkdir -p release && cp manifest.json dist/code.js dist/ui.html release/"
  },
  "author": "Jon Cheney",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.141.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1",
    "jszip": "^3.10.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true
}
